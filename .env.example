GROQ_API_KEY=your_groq_api_key_here
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password_here
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
MODERATION_PROVIDER=groq
MODERATION_MODEL=openai/gpt-oss-safeguard-20b
# Optional dedicated classifier key; otherwise GROQ_API_KEY is used.
MODERATION_API_KEY=
# Stable secret used to encrypt queued payloads. Generate with Fernet.generate_key().
MODERATION_ENCRYPTION_KEY=
# Hash-only moderation logs by default. Set true only if excerpts are covered by your privacy policy.
MODERATION_STORE_EXCERPT=false
MODERATION_STRIKE_DECAY_DAYS=90
MODERATION_RATE_LIMIT_WINDOW_HOURS=24
MODERATION_RATE_LIMIT_MAX_SENDS=1
